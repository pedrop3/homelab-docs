# Copy to homelab.tfvars and fill in. Read by the Makefile (Ansible) and by
# every OpenTofu stack. homelab.tfvars is git-ignored.
host            = "192.168.1.149" # server IP: reserve it in the router's DHCP
ssh_user        = "pedrosantos"
ssh_private_key = "~/.ssh/id_ed25519" # no passphrase: OpenTofu reads the file
ssh_port        = 22

